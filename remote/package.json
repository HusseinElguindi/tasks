{
  "name": "tasks-mcp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run && vitest run -c vitest.workers.config.ts",
    "test:node": "vitest run",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/dev-smoke.mjs",
    "parity": "pnpm parity:swift && pnpm parity:cli && pnpm parity:gzip",
    "parity:swift": "cd parity && mise x swift -- swift run golden ../test/golden",
    "parity:cli": "cd parity && node capture-cli.mjs",
    "parity:gzip": "gzip -9 -n -f test/golden/*.json"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@simplewebauthn/server": "^14.0.3",
    "fractional-indexing": "3.2.0",
    "sucrase": "3.35.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
