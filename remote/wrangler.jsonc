{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasks-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // node:crypto: SHA-256 for the derived ids (undo batches, add({key})), as the server uses it.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      // The replica of the log every client shares (idFromName("main")).
      { "name": "REPLICA", "class_name": "Replica" },
      // The owner's passkey and the one-time registration (idFromName("owner")).
      { "name": "AUTH", "class_name": "Auth" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Replica", "Auth"] }],
  // workers-oauth-provider's storage: clients, grants, tokens (hashed). Before the first deploy:
  // `npx wrangler kv namespace create OAUTH_KV`, then put its id here. Locally it's simulated.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Code mode: each tasks_run script runs in a fresh isolate (src/codemode.ts).
  "worker_loaders": [{ "binding": "LOADER" }],
  // The main Worker (server/), unchanged: POST /v1/sync with Bearer SYNC_TOKEN.
  "services": [{ "binding": "SYNC", "service": "tasks" }],
  "vars": {
    // Today and every date the API reads or writes: an IANA zone, through Intl.
    "TIME_ZONE": "America/Toronto",
    // Numeric date phrases ("3/4"): md or dm, the CLI's TASKS_DATE_ORDER.
    "DATE_ORDER": "md"
  },
  // SYNC_TOKEN: the main Worker's API_TOKEN. SETUP_SECRET: opens /setup for the first passkey (then unused).
  // Locally, dummy ones in .dev.vars.
  "secrets": { "required": ["SYNC_TOKEN", "SETUP_SECRET"] },
  "observability": { "enabled": true }
}
