    "title": {
      "kind": "title1",
      "x": 0,
      "y": -300,
      "maxW": 3200,
      "text": "Tasks · A small sync indicator (§26, proposed)"
    },
    "howto": {
      "x": -560,
      "y": 0,
      "w": 480,
      "size": 24,
      "text": "A cloud at the right end of the sidebar’s header row, 14pt, shown only when there’s something to say.\n\nBoards are at 2×. Each shows the state with its tooltip (hovered).\n\nThe timing board (right) is live, and the component under it shows a real hover: start a sync and watch when the cloud shows."
    },
    "t_light": {
      "kind": "title1",
      "x": 0,
      "y": 1792,
      "maxW": 3200,
      "text": "Light"
    },
    "t_coll": {
      "kind": "title1",
      "x": 0,
      "y": 3884,
      "maxW": 3200,
      "text": "Sidebar collapsed: problems only, beside the toggle"
    },
    "n_coll": {
      "x": -560,
      "y": 4184,
      "w": 480,
      "size": 24,
      "text": "With the sidebar hidden, or the header scrolled out of view, only offline and stopped show: a 28pt round button right of the sidebar toggle, its glyph 16pt like the toggle’s. Syncing never shows there."
    },
    "t_foot": {
      "kind": "title1",
      "x": 0,
      "y": 4536,
      "maxW": 3200,
      "text": "Variant, not recommended: the sidebar’s foot"
    },
    "n_foot": {
      "x": -560,
      "y": 4836,
      "w": 480,
      "size": 24,
      "text": "A line at the foot of the sidebar is always there, so it says “Synced” all day. The sidebar has no foot today; this would add one for one line."
    }
  }
