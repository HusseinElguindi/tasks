  "notes": {
    "title": { "kind": "title1", "x": 0, "y": -300, "maxW": 3000, "text": "Tasks · Themes" },
    "howto": { "x": -560, "y": 0, "w": 480, "size": 24, "text": "How to try it\n\n• Press Play on the prototype. The strip at its foot picks the theme, Dark or Light, Classic or Glass, and whether a switch is instant or fades.\n• Everything is the prototype-v2 app, unchanged, drawn from one theme’s derived tokens.\n• The picker beside it is the Settings pane: choose a card and the window follows." },
    "n_picker": { "x": 3076, "y": 0, "w": 480, "size": 24, "text": "A theme is a small file: base, ink and accent per appearance, with optional ground, list colours, danger, attention and a high-contrast flag. Everything else is derived, then checked against contrast floors." },
    "t_tokens": { "kind": "title1", "x": 0, "y": 877, "maxW": 1880, "text": "The token inventory" },
    "n_tokens": { "x": -560, "y": 1100, "w": 480, "size": 24, "text": "Every colour token, grouped, in the theme you pick. The source column says whether it’s the theme’s own colour, a rule, a pinned Rex value, or raised to meet a floor; the last column is its lowest contrast.\n\nBelow: what stays fixed, what bypasses the tokens today, and the whole contrast check." },
    "t_choices": { "kind": "title1", "x": 0, "y": 3037, "maxW": 4800, "text": "The choices" },
    "n_choices": { "x": -560, "y": 3260, "w": 480, "size": 24, "text": "Three real choices. Recommended: 1A, a theme is a pair; 2A, cards in Settings plus a View ▸ Theme menu; 3, colours only, with radii and the font fixed." },
    "t_glass": { "kind": "title1", "x": 0, "y": 4317, "maxW": 2080, "text": "Glass, with a theme" },
    "n_glass": { "x": -560, "y": 4540, "w": 480, "size": 24, "text": "Glass is orthogonal to the theme: the theme’s ground at 60% over the blurred desktop, its panes at 88%. A theme can’t change those numbers, so every theme’s contrast holds in Glass too." },
    "t_themes": { "kind": "title1", "x": 0, "y": 5397, "maxW": 4600, "text": "Seven themes, dark and light" },
    "n_default": { "x": -560, "y": 5620, "w": 480, "size": 24, "text": "Default · Rex itself. Its file pins the measured values, so choosing it changes nothing. The rules alone land within 1–4 levels of each one." },
    "n_paper": { "x": -560, "y": 6520, "w": 480, "size": 24, "text": "Paper · warm paper and brown ink, a rust accent, earthy list colours. The floors raised ink-3 in dark, and ink-2 on a selection and ink-3 on the sidebar in light." },
    "n_contrast": { "x": -560, "y": 7420, "w": 480, "size": 24, "text": "Contrast · black and white. Its high-contrast flag halves the ink steps and strengthens lines and edges 1.6×. Passes every floor as drawn." },
    "n_dusk": { "x": -560, "y": 8320, "w": 480, "size": 24, "text": "Dusk · muted slate, soft ink, a periwinkle accent. The quietest theme, so the floors do the most: they raise ink-3, ink-q and the checkbox ring." },
    "n_harbor": { "x": -560, "y": 9220, "w": 480, "size": 24, "text": "Harbor · cool blue-grey surfaces and a sky accent. In light, the tinted chips’ text is raised to 4.5:1." },
    "n_iris": { "x": -560, "y": 10120, "w": 480, "size": 24, "text": "Iris · the default’s surfaces with one vivid violet accent: the smallest theme there is, three colours a side." },
    "n_moss": { "x": -560, "y": 11020, "w": 480, "size": 24, "text": "Moss · green-grey surfaces and a leaf accent." }
  }
