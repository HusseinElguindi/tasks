{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasks",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // node:crypto gives a synchronous SHA-256, so an append never yields mid-transaction.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "LOG", "class_name": "UserLog" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserLog"] }],
  // Set at first deploy with --secrets-file (see DEPLOY.md); .dev.vars locally.
  "secrets": { "required": ["API_TOKEN"] },
  "observability": { "enabled": true }
}
